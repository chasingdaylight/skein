{
  "name": "skein",
  "displayName": "skein",
  "description": "Highlights skein's item markers and references in Markdown, and brings the skein program.",
  "version": "0.1.1",
  "publisher": "chasingdaylight",
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/chasingdaylight/skein.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/chasingdaylight/skein",
  "bugs": {
    "url": "https://github.com/chasingdaylight/skein/issues"
  },
  "engines": {
    "vscode": "^1.147.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "requirements",
    "specification",
    "traceability",
    "markdown",
    "skein"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "skein.injection",
        "path": "./syntaxes/skein.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "commands": [
      {
        "command": "skein.showVersion",
        "title": "Show Version",
        "category": "skein"
      }
    ],
    "configuration": {
      "title": "skein",
      "properties": {
        "skein.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `skein` program to use in place of the one this extension carries: the full path of the file. Its directory is put first on the `PATH` of new terminals."
        }
      }
    }
  }
}
