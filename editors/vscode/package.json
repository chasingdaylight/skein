{
  "name": "skein",
  "displayName": "Skein",
  "description": "Requirements and traceability in Markdown: Skein's language server, the items in a tree, trace and coverage views, and the skein program.",
  "version": "0.2.1",
  "publisher": "chasingdaylight",
  "license": "MIT",
  "preview": true,
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chasingdaylight/skein.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/chasingdaylight/skein",
  "bugs": {
    "url": "https://github.com/chasingdaylight/skein/issues"
  },
  "engines": {
    "vscode": "^1.147.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.skein/config.toml"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "requirements",
    "specification",
    "traceability",
    "markdown",
    "skein"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, skein.path is taken only from the user's settings, and the language server is not started.",
      "restrictedConfigurations": [
        "skein.path"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "skein.injection",
        "path": "./syntaxes/skein.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "skein.mcp",
        "label": "Skein"
      }
    ],
    "languageModelTools": [
      {
        "name": "skein_item",
        "displayName": "Skein Item",
        "toolReferenceName": "skeinItem",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-key)",
        "userDescription": "The Skein item under the cursor, or the one named, with its links, references, citations, results and all above and below it.",
        "modelDescription": "Gives the trace of a Skein item (a requirement, rule, test or other item kept in the repository's Markdown with a %type[ID ...] marker): its type, status, text, attributes, links to and from other items, references, citations in code and tests, approvals, test results, and every item above and below it. Without an ID, the item under the cursor in the active editor. Use it before changing an item or what traces to it.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The ID of the item; leave out for the item under the cursor."
            }
          }
        }
      }
    ],
    "views": {
      "skein": [
        {
          "id": "skein.items",
          "name": "Items",
          "when": "skein.project",
          "icon": "media/skein.svg",
          "contextualTitle": "Skein"
        }
      ]
    },
    "commands": [
      {
        "command": "skein.showVersion",
        "title": "Show Version",
        "category": "Skein"
      },
      {
        "command": "skein.restartServer",
        "title": "Restart the Language Server",
        "category": "Skein"
      },
      {
        "command": "skein.refreshItems",
        "title": "Refresh Items",
        "category": "Skein",
        "icon": "$(refresh)"
      },
      {
        "command": "skein.openItem",
        "title": "Go to Item...",
        "category": "Skein",
        "icon": "$(search)"
      },
      {
        "command": "skein.trace",
        "title": "Trace",
        "category": "Skein",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "skein.showCoverage",
        "title": "Show Coverage",
        "category": "Skein",
        "icon": "$(checklist)"
      },
      {
        "command": "skein.showPlan",
        "title": "Show Plan",
        "category": "Skein",
        "icon": "$(calendar)"
      },
      {
        "command": "skein.newItem",
        "title": "New Item...",
        "category": "Skein",
        "icon": "$(add)"
      },
      {
        "command": "skein.editItem",
        "title": "Edit Item...",
        "category": "Skein",
        "icon": "$(edit)"
      },
      {
        "command": "skein.showGraph",
        "title": "Show Graph",
        "category": "Skein",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "skein.writeAgentInstructions",
        "title": "Write Agent Instructions",
        "category": "Skein"
      },
      {
        "command": "skein.copyId",
        "title": "Copy ID",
        "category": "Skein"
      },
      {
        "command": "skein.chooseProject",
        "title": "Choose Project...",
        "category": "Skein",
        "icon": "$(folder-library)"
      },
      {
        "command": "skein.pickLinked",
        "title": "Go to a Linked Item...",
        "category": "Skein"
      },
      {
        "command": "skein.newItemHere",
        "title": "New Item in This Document...",
        "category": "Skein",
        "icon": "$(add)"
      },
      {
        "command": "skein.initProject",
        "title": "Initialize a Project...",
        "category": "Skein"
      },
      {
        "command": "skein.showCommands",
        "title": "Show All Commands...",
        "category": "Skein"
      },
      {
        "command": "skein.gettingStarted",
        "title": "Get Started",
        "category": "Skein"
      },
      {
        "command": "skein.openDocs",
        "title": "Open the Documentation",
        "category": "Skein"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "skein.trace",
          "when": "skein.project"
        },
        {
          "command": "skein.showCoverage",
          "when": "skein.project"
        },
        {
          "command": "skein.showPlan",
          "when": "skein.project"
        },
        {
          "command": "skein.writeAgentInstructions",
          "when": "skein.project"
        },
        {
          "command": "skein.showGraph",
          "when": "skein.project"
        },
        {
          "command": "skein.newItem",
          "when": "skein.project"
        },
        {
          "command": "skein.editItem",
          "when": "skein.project"
        },
        {
          "command": "skein.openItem",
          "when": "skein.project"
        },
        {
          "command": "skein.refreshItems",
          "when": "skein.project"
        },
        {
          "command": "skein.copyId",
          "when": "false"
        },
        {
          "command": "skein.chooseProject",
          "when": "skein.projects"
        },
        {
          "command": "skein.pickLinked",
          "when": "false"
        },
        {
          "command": "skein.newItemHere",
          "when": "skein.project && resourceLangId == markdown"
        },
        {
          "command": "skein.initProject",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/context": [
        {
          "command": "skein.trace",
          "when": "skein.project && resourceScheme == file",
          "group": "navigation@90"
        },
        {
          "command": "skein.editItem",
          "when": "skein.project && resourceScheme == file",
          "group": "navigation@91"
        },
        {
          "command": "skein.newItemHere",
          "when": "skein.project && resourceLangId == markdown && resourceScheme == file",
          "group": "navigation@92"
        }
      ],
      "view/title": [
        {
          "command": "skein.newItem",
          "when": "view == skein.items",
          "group": "navigation@0"
        },
        {
          "command": "skein.openItem",
          "when": "view == skein.items",
          "group": "navigation@0"
        },
        {
          "command": "skein.refreshItems",
          "when": "view == skein.items",
          "group": "navigation@1"
        },
        {
          "command": "skein.showCoverage",
          "when": "view == skein.items",
          "group": "navigation@2"
        },
        {
          "command": "skein.showPlan",
          "when": "view == skein.items",
          "group": "navigation@3"
        },
        {
          "command": "skein.showGraph",
          "when": "view == skein.items",
          "group": "navigation@4"
        },
        {
          "command": "skein.chooseProject",
          "when": "view == skein.items && skein.projects",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "skein.trace",
          "when": "view == skein.items && viewItem == item",
          "group": "inline"
        },
        {
          "command": "skein.trace",
          "when": "view == skein.items && viewItem == item",
          "group": "1_skein@1"
        },
        {
          "command": "skein.copyId",
          "when": "view == skein.items && viewItem == item",
          "group": "1_skein@2"
        },
        {
          "command": "skein.editItem",
          "when": "view == skein.items && viewItem == item",
          "group": "1_skein@3"
        },
        {
          "command": "skein.openItem",
          "when": "view == skein.items && viewItem == item",
          "group": "1_skein@0"
        }
      ],
      "editor/title": [
        {
          "submenu": "skein.editor",
          "when": "skein.project && resourceLangId == markdown && resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "skein.editor": [
        {
          "command": "skein.newItemHere",
          "group": "1_item@1"
        },
        {
          "command": "skein.editItem",
          "group": "1_item@2"
        },
        {
          "command": "skein.trace",
          "group": "1_item@3"
        },
        {
          "command": "skein.openItem",
          "group": "1_item@4"
        },
        {
          "command": "skein.showCoverage",
          "group": "2_views@1"
        },
        {
          "command": "skein.showPlan",
          "group": "2_views@2"
        },
        {
          "command": "skein.showGraph",
          "group": "2_views@3"
        },
        {
          "command": "skein.showCommands",
          "group": "3_more@1"
        }
      ]
    },
    "configuration": {
      "title": "Skein",
      "properties": {
        "skein.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `skein` program to use in place of the one this extension carries: the full path of the file. It is the language server, and its directory is put first on the `PATH` of new terminals."
        },
        "skein.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a code lens above each item: its links, which open a choice of the items they lead to, and **Trace**."
        },
        "skein.statusBar.coverage": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show in the status bar how much of what is expected is covered (`skein coverage`); clicking it opens the coverage view."
        },
        "skein.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer `skein mcp`, Skein's tools over the Model Context Protocol, to VS Code's AI agents in a trusted workspace: finding and tracing items, `check`, `coverage`, `impact`, and the editing commands."
        },
        "skein.agents.file": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The file **Skein: Write Agent Instructions** writes the section on Skein into, from the project's root. Empty: `AGENTS.md`, or `CLAUDE.md` where there is one and no `AGENTS.md`."
        },
        "skein.agents.skill": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Have **Skein: Write Agent Instructions** write a skill file (`.claude/skills/skein/SKILL.md`, or `skein.agents.file`) instead of a section of the agent instructions."
        },
        "skein.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Log the messages between VS Code and the language server in the output channel **Skein Language Server**: none, each message, or each with its content."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skein",
          "title": "Skein",
          "icon": "media/skein.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skein.items",
        "when": "skein.project && !skein.running",
        "contents": "The Skein language server is not running.\n[Restart the Language Server](command:skein.restartServer)\nIts log is in the output channel Skein Language Server."
      },
      {
        "view": "skein.items",
        "when": "skein.project && skein.running",
        "contents": "This project has no items yet. An item is a paragraph of a Markdown document that starts with a marker, such as `%req[ID]`.\n[New Item](command:skein.newItem)\n[Get Started](command:skein.gettingStarted)"
      }
    ],
    "submenus": [
      {
        "id": "skein.editor",
        "label": "Skein",
        "icon": {
          "light": "media/skein.svg",
          "dark": "media/skein-dark.svg"
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "skein.start",
        "title": "Get Started with Skein",
        "description": "Requirements and their traceability in Markdown: write items, see them rendered, trace them, and check their coverage.",
        "steps": [
          {
            "id": "project",
            "title": "Open or start a project",
            "description": "A Skein project is a directory with a .skein directory in it. Open one, or start one with a template.\n[Initialize a Project](command:skein.initProject)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:skein.project"
            ]
          },
          {
            "id": "items",
            "title": "Write an item",
            "description": "An item is a paragraph or list entry that starts with a marker, such as %req[ID]; %[ID] refers to it.\n[Open the Guide to Writing Items](command:skein.openDocs)",
            "media": {
              "markdown": "media/walkthrough/items.md"
            }
          },
          {
            "id": "preview",
            "title": "See it rendered",
            "description": "The Markdown preview shows each item with its ID and status, and references as links.\n[Open the Preview to the Side](command:markdown.showPreviewToSide)",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:markdown.showPreviewToSide"
            ]
          },
          {
            "id": "itemsView",
            "title": "Browse the items",
            "description": "The Skein icon in the activity bar opens the Items view.\n[Show the Items](command:workbench.view.extension.skein)",
            "media": {
              "markdown": "media/walkthrough/items-view.md"
            },
            "completionEvents": [
              "onView:skein.items"
            ]
          },
          {
            "id": "forms",
            "title": "New and edit items with forms",
            "description": "A form of the item type's fields, written into the file.\n[New Item](command:skein.newItem)",
            "media": {
              "markdown": "media/walkthrough/forms.md"
            },
            "completionEvents": [
              "onCommand:skein.newItem",
              "onCommand:skein.editItem"
            ]
          },
          {
            "id": "trace",
            "title": "Trace, coverage, plan and graph",
            "description": "What is above and below an item, what is not yet covered, the schedule and the network.\n[Trace an Item](command:skein.trace)\n[Show Coverage](command:skein.showCoverage)",
            "media": {
              "markdown": "media/walkthrough/trace.md"
            },
            "completionEvents": [
              "onCommand:skein.trace",
              "onCommand:skein.showCoverage"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node24 --minify --sourcemap && esbuild src/webview/plan.ts src/webview/graph.ts src/webview/form.ts --bundle --outdir=dist --format=iife --platform=browser --target=es2022 --minify",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "unit": "esbuild test/unit/*.test.ts --bundle --outdir=out/unit --platform=node --target=node24 --format=cjs && node --test out/unit/*.test.js"
  },
  "overrides": {
    "minimatch": "11.0.9"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.146.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
