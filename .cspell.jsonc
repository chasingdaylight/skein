{
  "version": "0.2",
  "ignorePaths": [
    ".cspell.json*",
    ".git/**",
    "*.code-workspace",
    ".gitignore",
    ".local-gitignore",
    ".site/**",
    "zig-pkg/**",
    ".zig-cache*/**",
    "zig-out/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".vscode/ltex.dictionary.en-US.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "bash",
    "win32",
    "zig",
    "project-words"
  ],
  "allowCompoundWords": true
}
