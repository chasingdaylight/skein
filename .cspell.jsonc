{
  "version": "0.2",
  "ignorePaths": [
    ".cspell.json*",
    ".git/**",
    "*.code-workspace",
    ".gitignore",
    ".local-gitignore",
    ".site/**",
    "zig-pkg/**",
    ".zig-cache*/**",
    "zig-out/**",
    "**/node_modules/**",
    "editors/vscode/package-lock.json",
    // the standards' own text, as the templates carry it, and what it was taken from
    "templates/*/project/standards/**",
    // code of other projects, as they published it
    "vendor/mermaid/**",
    "tools/npr7150/*.csv"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".vscode/ltex.dictionary.en-US.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "bash",
    "win32",
    "zig",
    "project-words"
  ],
  "allowCompoundWords": true
}
